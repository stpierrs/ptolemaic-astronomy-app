{
  "name": "shanes-model",
  "version": "2.0.0",
  "description": "Ptolemaic geocentric astronomy and astrology simulator",
  "private": true,
  "scripts": {
    "build":          "node scripts/build-www.js",
    "sync":           "npm run build && cap sync",
    "open:android":   "cap open android",
    "open:ios":       "cap open ios",
    "build:android":  "npm run sync && cap open android",
    "gen-icons":      "npx @capacitor/assets generate",
    "dev":            "node scripts/dev-server.js",
    "dev:https":      "cross-env SSL=1 node scripts/dev-server.js",
    "dev:bundle":     "node scripts/dev-bundle.js",
    "dev:cap:on":     "node scripts/cap-dev.js on",
    "dev:cap:off":    "node scripts/cap-dev.js off",
    "dev:android":    "node scripts/cap-dev.js on && npx cap sync android && npx cap run android",
    "gen:devtools":   "node scripts/gen-devtools-md.js"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core":    "^6.0.0",
    "@capacitor/ios":     "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli":    "^6.0.0"
  }
}
